# Allow list: ignore everything, then re-include what the image build needs.
# The Dockerfile copies pyproject.toml, uv.lock, README.md (read by hatchling)
# and src/ only.
*

!pyproject.toml
!uv.lock
!README.md
!src/

# Never ship caches or bytecode, even from src/
**/__pycache__
**/*.py[cod]
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
